# Google Sheets
SPREADSHEET_ID=tu_spreadsheet_id_aqui

# Service Account JSON completo (pegar el contenido del credentials.json como string)
# En Vercel: Settings → Environment Variables → pegar el JSON completo
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Auth
BASIC_AUTH_USER=tu_usuario
BASIC_AUTH_PASS=tu_password
SESSION_SECRET=cambia_esto_por_un_string_aleatorio_seguro

# El calendario financiero (balances, dividendos, renta/amortización de bonos ARG)
# usa fuentes públicas sin API key: Yahoo Finance, Nasdaq, bonistas.com y data912.
# No requiere ninguna variable adicional.

# Alerta semanal de cobros por mail (/api/alertas/semanal).
# Secreto propio para el cron externo que dispara el envío (no es la sesión de usuario).
CRON_SECRET=genera_un_string_aleatorio_seguro

# Destinatario del mail de alerta semanal.
ALERTA_EMAIL=tu_mail@ejemplo.com

# Resend (https://resend.com/api-keys) - envío del mail de alerta semanal.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: remitente propio si verificaste un dominio en Resend
# (Settings → Domains). Sin esto se usa el sandbox de Resend, que solo
# entrega al mail con el que te registraste en la cuenta.
# RESEND_FROM=Portfolio <alertas@tu-dominio.com>
